# Copy to .env in this directory and `chmod 600` it.
# API token: e-boekhouden > Beheer > Inrichting > Koppelingen > API > e-Boekhouden API
EB_API_TOKEN=
# Optional: identifies this integration to e-boekhouden (max 10 chars: letters, digits, _, space)
EB_SOURCE=MCP
# Optional: expose create/update/delete tools (default: read-only)
EB_ALLOW_WRITES=false
